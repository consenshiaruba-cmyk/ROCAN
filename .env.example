# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
MOCK_MODE=1
CLOCK_MODE=real
DATABASE_URL=postgres://rocan:rocan@localhost:5432/rocan
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rocan
S3_SECRET_ACCESS_KEY=rocan-dev-secret
S3_FORCE_PATH_STYLE=1
S3_BUCKET_INCOMING=rocan-incoming
S3_BUCKET_VAULT=rocan-vault
S3_BUCKET_DERIVATIVES=rocan-derivatives
S3_BUCKET_REPORTS=rocan-reports
VAULT_LOCK_DAYS=1825
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ROCAN <no-reply@rocan.test>"
PUBLIC_BASE_URL=http://localhost:3000
OPERATOR_NAME="ROCAN operator"
NEXT_TELEMETRY_DISABLED=1
